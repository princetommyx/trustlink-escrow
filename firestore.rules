rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication & authorization
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.email == 'admin@trustlink.com' ||
        request.auth.token.email == 'trustlinkescrow@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isValidAmount(amount) {
      return amount is number && amount >= 1 && amount <= 50000;
    }

    function isValidText(text, minLen, maxLen) {
      return text is string && text.size() >= minLen && text.size() <= maxLen;
    }

    // ---------------------------------------------------------------
    // Users Collection: Strict Profile Security & Wallet Protection
    // ---------------------------------------------------------------
    match /users/{userId} {
      // Users can read their own profile; admins can read all; public can read basic vendor info
      allow read: if isOwner(userId) || isAdmin() || resource.data.role == 'seller';

      // User creation during signup: wallet balances must start at 0
      allow create: if isOwner(userId) && (
        !('walletBalance' in request.resource.data) || request.resource.data.walletBalance == 0
      ) && (
        !('escrowBalance' in request.resource.data) || request.resource.data.escrowBalance == 0
      );

      // User updates: Users CANNOT alter their own walletBalance, escrowBalance, or role directly.
      // Balances can only be updated server-side via Cloud Functions (Admin SDK).
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'fullName', 'phone', 'intlPhone', 'businessName',
          'profileComplete', 'updatedAt', 'avatarUrl', 'momoNumber', 'momoNetwork', 'notifications'
        ])
      );

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Escrows Collection: Transaction State Machine & Validation
    // ---------------------------------------------------------------
    match /escrows/{escrowId} {
      // Public read required for checkout (unauthenticated buyer) and dashboard (seller)
      allow read: if true;

      // Escrow creation: Must be authenticated seller OR valid pending escrow creation with valid amount
      allow create: if (
        (isAuthenticated() && request.resource.data.sellerId == request.auth.uid) ||
        (request.resource.data.status == 'PENDING_PAYMENT' && isValidAmount(request.resource.data.amount))
      ) &&
      isValidText(request.resource.data.description, 1, 500);

      // Escrow state updates:
      // 1. Seller can mark as DISPATCHED / ITEM_SHIPPED
      // 2. Buyer can confirm delivery (COMPLETED) or raise DISPUTED
      // 3. Admin can update or resolve disputes
      // 4. Financial amount, sellerId, and createdAt are IMMUTABLE
      allow update: if (
        isAdmin() ||
        (
          // Protect immutable financial fields
          request.resource.data.amount == resource.data.amount &&
          request.resource.data.sellerId == resource.data.sellerId &&
          (
            // Seller marking dispatch
            (
              isOwner(resource.data.sellerId) &&
              request.resource.data.status in ['ITEM_SHIPPED', 'DISPATCHED', 'PENDING_PAYMENT', 'CANCELLED']
            ) ||
            // Buyer / Client completing delivery or raising dispute
            (
              request.resource.data.status in ['COMPLETED', 'DISPUTED', 'FUNDS_ESCROWED', 'FUNDED']
            )
          )
        )
      );

      // Deletion is strictly disallowed for auditing integrity
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // Transactions Ledger Collection (Append-Only)
    // ---------------------------------------------------------------
    match /transactions/{txId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.userId) || isAdmin()
      );
      // Transactions can be logged by authenticated users or Cloud Functions
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid || isAdmin()
      );
      // Transactions are immutable once created
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------
    // Audit Logs Collection (Immutable Security Ledger)
    // ---------------------------------------------------------------
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      // Allow appending audit log events
      allow create: if true;
      // Never allow modifying or deleting audit trails
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------
    // OTP & Verification Storage: Server-Side Cloud Functions Only
    // ---------------------------------------------------------------
    match /phone_otps/{phone} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------
    // Products Collection
    // ---------------------------------------------------------------
    match /products/{productId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
